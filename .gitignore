# Directories/files that may be generated by this project
build
build-module
build-style
build-types
node_modules
gutenberg.zip
coverage
*-performance-results.json

# Directories/files that may appear in your environment
*.log
yarn.lock
/artifacts

# The /.cache directory holds the PHPCS scan cache, which the `phpcs` CI job
# persists between runs. Every other .cache directory stays ignored. A file
# cannot be re-included once a parent directory is excluded, so /.cache and
# /.cache/.gitkeep must both be re-included explicitly.
.cache
!/.cache/
/.cache/**
!/.cache/.gitkeep

*.tsbuildinfo

# Operating system specific files
.DS_Store
Thumbs.db

# Report generated from jest-junit
test/native/junit.xml

# Local overrides
.wp-env.override.json
phpcs.xml
phpunit.xml
phpunit-watcher.yml
