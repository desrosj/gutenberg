{
	"$schema": "../../schemas/json/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "840px",
			"wideSize": "1100px"
		},
		"typography": {
			"textIndent": {
				"enabled": false,
				"indentRule": "skipFirst"
			}
		}
	},
	"styles": {
		"blocks": {
			"core/paragraph": {
				"typography": {
					"textIndent": "2em"
				}
			}
		}
	}
}
